# Copy to .env (pipeline) and web/.env.local (web app). Never commit the real files.
# Local Postgres from docker-compose.yml:
DATABASE_URL=postgresql://gpi:gpi@localhost:5432/gpi
# Hosted Postgres (Neon / Supabase / Vercel Postgres): paste the POOLED connection string instead.

# --- Backend (web/) ---
# Required in production for /api/agent and /api/outcomes (they refuse to run without it).
# Callers send it as `x-api-key: <value>`. Generate one: openssl rand -hex 24
APP_ACCESS_KEY=
# Required for /api/agent (the LLM matching agent). /api/match works without it.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5. Set a cheaper model to cut agent cost.
# ANTHROPIC_MODEL=
# Optional. Set to "off" to disable server-side refusal fallbacks on the agent.
# ANTHROPIC_FALLBACKS=
