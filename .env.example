# Copy to .env (pipeline) and web/.env.local (web app). Never commit the real files.
# Local Postgres from docker-compose.yml:
DATABASE_URL=postgresql://gpi:gpi@localhost:5432/gpi
# Hosted Postgres (Neon / Supabase / Vercel Postgres): paste the POOLED connection string instead.
# Later, for LLM classification:
# ANTHROPIC_API_KEY=
